<Application xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
x:Class="Workspace.App"
RequestedThemeVariant="Light">
<!-- Force a light theme so widgets use light colours by default. -->

<Application.Styles>
    <FluentTheme />
</Application.Styles>


</Application>
