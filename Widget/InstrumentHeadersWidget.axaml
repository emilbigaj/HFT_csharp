<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Widget"
             x:Class="Widget.InstrumentHeadersWidget"
             x:DataType="local:WidgetInstrumentHeader">

	<UserControl.Styles>
		<StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
	</UserControl.Styles>
	
	<DataGrid x:Name="HeadersGrid"
			  Background="Transparent"
			  AutoGenerateColumns="False"
			  IsReadOnly="True"
			  CanUserSortColumns="True"
			  GridLinesVisibility="All"
			  BorderThickness="1"
			  BorderBrush="Gray"
			  RowBackground="White"
			  HeadersVisibility="Column">


		<DataGrid.Styles>
			<Style Selector="DataGridRow:nth-child(2n)">
				<Setter Property="Background" Value="#F0F0F0" />
			</Style>
		</DataGrid.Styles>

		<DataGrid.ContextMenu>
			<ContextMenu Opened="OnContextMenuOpened" />
		</DataGrid.ContextMenu>

		<!-- SortMemberPath is explicit on every column: these are compiled bindings (x:DataType),
		     and the DataGrid cannot infer a sort path from them — without it a header click is a no-op.
		     Date columns sort on their ISO yyyy-MM-dd strings (chronological == lexical). -->
		<DataGrid.Columns>
			<DataGridTextColumn Header="ShortSymbol" Binding="{Binding ShortSymbol}" SortMemberPath="ShortSymbol" />
			<DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" SortMemberPath="Symbol" />
			<DataGridTextColumn Header="InstrumentType" Binding="{Binding InstrumentType}" SortMemberPath="InstrumentType" />
			<DataGridTextColumn Header="CoreGroupId" Binding="{Binding CoreGroupId}" SortMemberPath="CoreGroupId" />
			<DataGridTextColumn Header="InstrumentHeaderId" Binding="{Binding InstrumentHeaderId}" SortMemberPath="InstrumentHeaderId" />
			<DataGridTextColumn Header="InstrumentId" Binding="{Binding InstrumentId}" SortMemberPath="InstrumentId" />
			<DataGridTextColumn Header="ExchangeInstrumentId" Binding="{Binding ExchangeInstrumentId}" SortMemberPath="ExchangeInstrumentId" />
			<DataGridTextColumn Header="Exchange" Binding="{Binding Exchange}" SortMemberPath="Exchange" />
			<DataGridTextColumn Header="Root" Binding="{Binding Root}" SortMemberPath="Root" />
			<DataGridTextColumn Header="TradingStatus" Binding="{Binding TradingStatus}" SortMemberPath="TradingStatus" />

			<DataGridTextColumn Header="TickSize" Binding="{Binding TickSize}" SortMemberPath="TickSize" />
			<DataGridTextColumn Header="InverseTickSize" Binding="{Binding InverseTickSize}" SortMemberPath="InverseTickSize" IsVisible="False" />

			<DataGridTextColumn Header="Multiplier" Binding="{Binding Multiplier}" SortMemberPath="Multiplier" IsVisible="True" />
			<DataGridTextColumn Header="MaturityDate" Binding="{Binding MaturityDate}" SortMemberPath="MaturityDate" IsVisible="False" />
			<DataGridTextColumn Header="MaturityType" Binding="{Binding MaturityType}" SortMemberPath="MaturityType" IsVisible="False" />

			<DataGridTextColumn Header="Leg0" Binding="{Binding Leg0}" SortMemberPath="Leg0" IsVisible="False" />
			<DataGridTextColumn Header="Leg1" Binding="{Binding Leg1}" SortMemberPath="Leg1" IsVisible="False" />
			<DataGridTextColumn Header="Leg2" Binding="{Binding Leg2}" SortMemberPath="Leg2" IsVisible="False" />
			<DataGridTextColumn Header="Leg3" Binding="{Binding Leg3}" SortMemberPath="Leg3" IsVisible="False" />
			<DataGridTextColumn Header="Leg4" Binding="{Binding Leg4}" SortMemberPath="Leg4" IsVisible="False" />
			<DataGridTextColumn Header="Leg5" Binding="{Binding Leg5}" SortMemberPath="Leg5" IsVisible="False" />

			<DataGridTextColumn Header="BaseCurrency" Binding="{Binding BaseCurrency}" SortMemberPath="BaseCurrency" IsVisible="False" />
			<DataGridTextColumn Header="QuoteCurrency" Binding="{Binding QuoteCurrency}" SortMemberPath="QuoteCurrency" IsVisible="False" />
		</DataGrid.Columns>
	</DataGrid>
</UserControl>