<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Widget"
             xmlns:data="clr-namespace:Data;assembly=Data"
             x:Class="Widget.LadderWidget">

	<UserControl.Styles>
		<!-- Why: the Fluent ComboBox keeps a fixed 32 px column for its arrow and clips the symbol before it; the symbol may run to 18 px
		     from the edge, the arrow 4 px from it -->
		<Style Selector="ComboBox#InstrumentPicker /template/ ContentControl#ContentPresenter">
			<Setter Property="Grid.ColumnSpan" Value="2"/>
			<Setter Property="Margin" Value="6,2,18,2"/>
			<Setter Property="ClipToBounds" Value="True"/>
		</Style>
		<Style Selector="ComboBox#InstrumentPicker /template/ PathIcon#DropDownGlyph">
			<Setter Property="Margin" Value="0,0,4,0"/>
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto,*">
		<!-- Added PointerPressed handler to the Header Border -->
		<Border Grid.Row="0"
                Padding="5"
                Background="#FAFAFA"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                PointerPressed="OnHeaderPointerPressed">

			<Grid RowDefinitions="Auto,Auto" RowSpacing="3">
				<!-- Why in the widget and not the frame's title bar: the phone hosts the widget without a frame, and so shows this row too -->
				<Grid Grid.Row="0" ColumnDefinitions="7*,6*">
					<!-- Why MinHeight: the Fluent ComboBox asks for 32 px, which made the header taller than the two rows of text in it need -->
					<ComboBox x:Name="InstrumentPicker" Grid.Column="0" HorizontalAlignment="Stretch" Padding="6,2" MinHeight="24" DropDownOpened="OnInstrumentPickerOpened" SelectionChanged="OnInstrumentPicked" ToolTip.Tip="Instrument">
						<!-- Why a compiled binding: a published (trimmed, NativeAOT) desk strips the property a reflection binding looks up -->
						<ComboBox.ItemTemplate>
							<DataTemplate x:DataType="data:Instrument">
								<TextBlock Text="{Binding ShortSymbol}" TextTrimming="CharacterEllipsis"/>
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
					<TextBlock x:Name="TradingStatusValue" Grid.Column="1" Foreground="Black" Text="Unknown" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="Trading Status"/>
				</Grid>
				<!-- Why the narrower first column: a position is a handful of digits, where either money figure may run to a signed thousands number -->
				<Grid Grid.Row="1" ColumnDefinitions="4*,5*,5*">
					<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
						<TextBlock x:Name="PositionText" Foreground="Black" Text="Pos:"/>
						<TextBlock x:Name="PositionValue" Foreground="Black" Text="0" FontWeight="Bold" />
					</StackPanel>
					<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
						<TextBlock x:Name="PnLText" Foreground="Black" Text="PnL:" ToolTip.Tip="Floating plus realized profit"/>
						<TextBlock x:Name="PnLValue" Foreground="Black" Text="0.00" FontWeight="Bold" />
					</StackPanel>
					<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
						<TextBlock x:Name="FloatingText" Foreground="Black" Text="Flt:" ToolTip.Tip="Floating profit: the open position revalued at the mid"/>
						<TextBlock x:Name="FloatingValue" Foreground="Black" Text="0.00" FontWeight="Bold" />
					</StackPanel>
				</Grid>
			</Grid>
		</Border>

		<ScrollViewer Grid.Row="1"
                      x:Name="LadderScroller"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
			<local:FastLadderControl x:Name="LadderControl"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Top"/>
		</ScrollViewer>

	</Grid>
</UserControl>
