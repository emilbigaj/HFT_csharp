<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Widget"
             xmlns:data="clr-namespace:Data;assembly=Data"
             x:Class="Widget.LadderWidget">

	<UserControl.Styles>
		<!-- Why: the Fluent ComboBox keeps a fixed 32 px column for its arrow and clips the symbol before it; the symbol may run to 18 px
		     from the edge, the arrow 4 px from it -->
		<Style Selector="ComboBox#InstrumentPicker /template/ ContentControl#ContentPresenter">
			<Setter Property="Grid.ColumnSpan" Value="2"/>
			<Setter Property="Margin" Value="6,2,18,2"/>
			<Setter Property="ClipToBounds" Value="True"/>
		</Style>
		<Style Selector="ComboBox#InstrumentPicker /template/ PathIcon#DropDownGlyph">
			<Setter Property="Margin" Value="0,0,4,0"/>
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto,*">
		<!-- Added PointerPressed handler to the Header Border -->
		<Border Grid.Row="0"
                Padding="5"
                Background="#FAFAFA"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                PointerPressed="OnHeaderPointerPressed">

			<Grid ColumnDefinitions="5*,3*,5*">
				<ComboBox x:Name="InstrumentPicker" Grid.Column="0" HorizontalAlignment="Stretch" Padding="6,2" DropDownOpened="OnInstrumentPickerOpened" SelectionChanged="OnInstrumentPicked" ToolTip.Tip="Instrument">
					<!-- Why a compiled binding: a published (trimmed, NativeAOT) desk strips the property a reflection binding looks up -->
					<ComboBox.ItemTemplate>
						<DataTemplate x:DataType="data:Instrument">
							<TextBlock Text="{Binding ShortSymbol}" TextTrimming="CharacterEllipsis"/>
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>
				<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
					<TextBlock x:Name="PositionText" Foreground="Black" Text="Pos:"/>
					<TextBlock x:Name="PositionValue" Foreground="Black" Text="0" FontWeight="Bold" />
				</StackPanel>
				<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
					<TextBlock x:Name="PnLText" Foreground="Black" Text="PnL:" />
					<TextBlock x:Name="PnLValue" Foreground="Black" Text="0.00" FontWeight="Bold" />
				</StackPanel>
			</Grid>
		</Border>

		<ScrollViewer Grid.Row="1"
                      x:Name="LadderScroller"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
			<local:FastLadderControl x:Name="LadderControl"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Top"/>
		</ScrollViewer>

	</Grid>
</UserControl>
