<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Widget.SelectNamesDialog"
        Width="320" Height="400"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Grid Margin="10" RowDefinitions="*,Auto">
        <ListBox x:Name="NamesList" Grid.Row="0" SelectionMode="Multiple,Toggle"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
            <Button Content="Cancel" Click="OnCancelClick"/>
            <Button x:Name="ConfirmButton" Click="OnConfirmClick" Classes="accent"/>
        </StackPanel>
    </Grid>
</Window>
