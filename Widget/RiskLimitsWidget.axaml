<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Widget"
             x:Class="Widget.RiskLimitsWidget"
             x:DataType="local:WidgetRiskLimit">

	<UserControl.Styles>
		<StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
	</UserControl.Styles>

	<DataGrid x:Name="RiskLimitsGrid"
			  Background="Transparent"
			  AutoGenerateColumns="False"
			  IsReadOnly="True"
			  GridLinesVisibility="All"
			  BorderThickness="1"
			  BorderBrush="Gray"
			  RowBackground="White"
			  HeadersVisibility="Column"
			  CanUserSortColumns="True"
			  CanUserResizeColumns="True"
			  CanUserReorderColumns="True"
			  MinColumnWidth="80"
			  RowHeight="24">

		<DataGrid.Styles>
			<Style Selector="DataGridRow:nth-child(2n)">
				<Setter Property="Background" Value="#F0F0F0" />
			</Style>
		</DataGrid.Styles>

		<DataGrid.ContextMenu>
			<ContextMenu Opened="OnContextMenuOpened" />
		</DataGrid.ContextMenu>

		<DataGrid.Columns>
			<DataGridTextColumn Header="ShortSymbol"     Binding="{Binding ShortSymbol}" SortMemberPath="ShortSymbol"           Width="Auto"/>
			<DataGridTextColumn Header="Symbol"          Binding="{Binding Symbol}" SortMemberPath="Symbol"                Width="Auto" IsVisible="False"/>
			<DataGridTextColumn Header="InstrumentId"    Binding="{Binding InstrumentId}" SortMemberPath="InstrumentId"          Width="Auto" IsVisible="False"/>
			<DataGridTextColumn Header="MaxOrderQuantity"     Binding="{Binding MaxOrderQuantity}" SortMemberPath="MaxOrderQuantity"   Width="Auto"/>
			<DataGridTextColumn Header="MaxPositionQuantity"  Binding="{Binding MaxPositionQuantity}" SortMemberPath="MaxPositionQuantity" Width="Auto"/>
			<DataGridTextColumn Header="MaxFillsPerSession"   Binding="{Binding MaxFillsPerSession}" SortMemberPath="MaxFillsPerSession"  Width="Auto"/>
			<DataGridTextColumn Header="Position"                     Binding="{Binding PositionQuantity}" SortMemberPath="PositionQuantity"             Width="Auto"/>
			<DataGridTextColumn Header="FillsThisSession"             Binding="{Binding FillsThisSession}" SortMemberPath="FillsThisSession"             Width="Auto"/>
			<DataGridTextColumn Header="WorstWorkingLongQuantity"     Binding="{Binding WorstWorkingLongQuantity}" SortMemberPath="WorstWorkingLongQuantity"     Width="Auto" IsVisible="False"/>
			<DataGridTextColumn Header="WorstWorkingLongPosition"     Binding="{Binding WorstWorkingLongPosition}" SortMemberPath="WorstWorkingLongPosition"     Width="Auto"/>
			<DataGridTextColumn Header="WorstWorkingShortQuantity"    Binding="{Binding WorstWorkingShortQuantity}" SortMemberPath="WorstWorkingShortQuantity"    Width="Auto" IsVisible="False"/>
			<DataGridTextColumn Header="WorstWorkingShortPosition"    Binding="{Binding WorstWorkingShortPosition}" SortMemberPath="WorstWorkingShortPosition"    Width="Auto"/>
			<DataGridTextColumn Header="WorstWorkingFills"            Binding="{Binding WorstWorkingFills}" SortMemberPath="WorstWorkingFills"            Width="Auto" IsVisible="False"/>
			<DataGridTextColumn Header="WorstWorkingFillsThisSession" Binding="{Binding WorstWorkingFillsThisSession}" SortMemberPath="WorstWorkingFillsThisSession" Width="Auto"/>
			<DataGridTextColumn Header="Timestamp"       Binding="{Binding Timestamp}" SortMemberPath="Timestamp"             Width="Auto"/>
			<DataGridTextColumn Header="File"            Binding="{Binding RiskLimitFileName}" SortMemberPath="RiskLimitFileName"     Width="*" IsVisible="False"/>
		</DataGrid.Columns>
	</DataGrid>
</UserControl>