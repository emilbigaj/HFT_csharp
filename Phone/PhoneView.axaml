<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Phone.PhoneView">
    <DockPanel>
        <!-- The bar: the clock and the link's latency, and the picker of the one widget shown -->
        <Border x:Name="TopBar" DockPanel.Dock="Top" Padding="8,6">
            <StackPanel Spacing="4">
                <TextBlock x:Name="StatusText" FontSize="14" TextWrapping="Wrap" Text="starting…"/>
                <ComboBox x:Name="WidgetPicker" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Border>
        <!-- The widget's title bar: its buttons and readouts (Positions' Resume/Pause All and total PnL), on a desk title bar's
             background so their colours read as there; hidden for a widget with none -->
        <Border x:Name="TitleBarStrip" DockPanel.Dock="Top" Background="#F3F3F3" Padding="8,4" IsVisible="False">
            <ContentControl x:Name="TitleBarHost"/>
        </Border>
        <ContentControl x:Name="WidgetHost"/>
    </DockPanel>
</UserControl>
